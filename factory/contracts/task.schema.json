{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Software Factory Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "objective",
    "spec_revision",
    "acceptance_criteria",
    "risk",
    "budget"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "spec_revision": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_usd",
        "max_repair_attempts"
      ],
      "properties": {
        "max_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_repair_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "context_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
